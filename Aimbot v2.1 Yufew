-- --- Target Getter (สำหรับ Aimbot) ---
local function getTarget()
	if lockedTargetPlayer and lockedTargetPlayer.Parent then
		local char = lockedTargetPlayer.Character
		if char and char:FindFirstChild("Head") then
			local hum = char:FindFirstChild("Humanoid")
			if hum and hum.Health > 0 then return lockedTargetPlayer end
		end
	end

	local target, shortest = nil, math.huge
	if not localPlayer.Character or not localPlayer.Character:FindFirstChild("HumanoidRootPart") then return nil end
	local myPos = localPlayer.Character.HumanoidRootPart.Position

	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= localPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
			if localPlayer.Team and p.Team and localPlayer.Team == p.Team then continue end
			local hum = p.Character:FindFirstChild("Humanoid")
			if hum and hum.Health > 0 then
				local dist = (p.Character.HumanoidRootPart.Position - myPos).Magnitude
				if dist < shortest then shortest = dist; target = p end
			end
		end
	end
	return target
end

-- --- Main Loop (RenderStepped) ---
RunService.RenderStepped:Connect(function()
	-- 1. ESP
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= localPlayer and p.Character then
			local char = p.Character
			local hum = char:FindFirstChild("Humanoid")
			local head = char:FindFirstChild("Head")
			local isTeamMate = (localPlayer.Team and p.Team and localPlayer.Team == p.Team)

			local hl = char:FindFirstChild("YufewHighlight")
			if espEnabled and hum and hum.Health > 0 and not isTeamMate then
				if not hl then
					hl = Instance.new("Highlight")
					hl.Name = "YufewHighlight"
					hl.Adornee = char
					hl.FillColor = Color3.fromRGB(200, 30, 30)
					hl.OutlineColor = Color3.fromRGB(255, 255, 255)
					hl.FillTransparency = 0.5
					hl.OutlineTransparency = 0.5
					hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
					hl.Parent = char
				end
			else
				if hl then hl:Destroy() end
			end

			local tag = head and head:FindFirstChild("YufewTag")
			if espEnabled and head and hum and hum.Health > 0 and not isTeamMate then
				if not tag then
					tag = Instance.new("BillboardGui")
					tag.Name = "YufewTag"
					tag.Size = UDim2.new(0, 100, 0, 30)
					tag.StudsOffset = Vector3.new(0, 2.5, 0)
					tag.AlwaysOnTop = true
					local lbl = Instance.new("TextLabel", tag)
					lbl.Name = "Label"
					lbl.Size = UDim2.new(1, 0, 1, 0)
					lbl.BackgroundTransparency = 1
					lbl.TextColor3 = Color3.fromRGB(255, 80, 80)
					lbl.TextStrokeTransparency = 0
					lbl.Font = Enum.Font.GothamBold
					lbl.TextSize = 12
					tag.Parent = head
				end
				local lbl = tag:FindFirstChild("Label")
				if lbl then lbl.Text = "🎯 " .. p.DisplayName end
			else
				if tag then tag:Destroy() end
			end

			local tracer = char:FindFirstChild("YufewHubTracer")
			if espEnabled and head and hum and hum.Health > 0 and not isTeamMate then
				if not tracer then
					tracer = Instance.new("SelectionBox")
					tracer.Name = "YufewHubTracer"
					tracer.Color3 = Color3.fromRGB(255, 215, 0)
					tracer.LineThickness = 0.05
					tracer.SurfaceTransparency = 1
					tracer.Adornee = head
					tracer.Parent = char
				end
			else
				if tracer then tracer:Destroy() end
			end
		end
	end

	-- 2. Hitbox Expander (สีฟ้าพาสเทลสบายตา)
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= localPlayer and p.Character then
			local char = p.Character
			local hrp = char:FindFirstChild("HumanoidRootPart")
			local hum = char:FindFirstChild("Humanoid")
			local isTeamMate = (localPlayer.Team and p.Team and localPlayer.Team == p.Team)

			if hrp and hum and hum.Health > 0 and not isTeamMate then
				if hitboxEnabled then
					hrp.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)
					hrp.Color = Color3.fromRGB(100, 200, 255)
					hrp.Material = Enum.Material.Neon
					hrp.Transparency = 0.7
					hrp.CanCollide = false
				else
					hrp.Size = Vector3.new(2, 2, 1)
					hrp.Transparency = 1
					hrp.CanCollide = true
				end
			end
		end
	end

	-- 3. Aimbot
	if systemEnabled then
		local target = getTarget()
		if target and target.Character and target.Character:FindFirstChild("Head") then
			local head = target.Character.Head
			local targetCF = CFrame.new(camera.CFrame.Position, head.Position)
			local lerpAlpha = math.clamp(aimPercent / 100, 0.01, 1)
			camera.CFrame = camera.CFrame:Lerp(targetCF, lerpAlpha)
		end
	end

	-- 4. Kill Aura
	if killAuraEnabled then
		local currentTime = tick()
		if currentTime - lastAttackTime >= attackCooldown then
			if localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart") then
				local myHRP = localPlayer.Character.HumanoidRootPart
				local weapon = localPlayer.Character:FindFirstChildOfClass("Tool")
				if not weapon and localPlayer:FindFirstChild("Backpack") then
					weapon = localPlayer.Backpack:FindFirstChildOfClass("Tool")
					if weapon then
						local hum = localPlayer.Character:FindFirstChildOfClass("Humanoid")
						if hum then hum:EquipTool(weapon) end
					end
				end

				for _, p in ipairs(Players:GetPlayers()) do
					if p ~= localPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
						if localPlayer.Team and p.Team and localPlayer.Team == p.Team then continue end
						local enemyHRP = p.Character.HumanoidRootPart
						local enemyHum = p.Character:FindFirstChild("Humanoid")
						if enemyHum and enemyHum.Health > 0 then
							local dist = (enemyHRP.Position - myHRP.Position).Magnitude
							if dist <= killAuraRange then
								lastAttackTime = currentTime
								if weapon and weapon:IsA("Tool") then
									weapon:Activate()
									pcall(function()
										if weapon:FindFirstChild("RemoteEvent") then weapon.RemoteEvent:FireServer()
										elseif weapon:FindFirstChild("RemoteFunction") then weapon.RemoteFunction:InvokeServer() end
									end)
								end
								break
							end
						end
					end
				end
			end
		end
	end

	-- 5. Movement (WalkSpeed)
	if localPlayer.Character and localPlayer.Character:FindFirstChild("Humanoid") then
		local hum = localPlayer.Character.Humanoid
		if speedEnabled then
			hum.WalkSpeed = walkSpeedValue
		else
			hum.WalkSpeed = 16
		end
	end
end)
